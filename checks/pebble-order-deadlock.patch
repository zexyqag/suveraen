From 755eb89b230af46382483a639837c8e6a508c39c Mon Sep 17 00:00:00 2001
From: Joe Orton <jorton@apache.org>
Date: Tue, 22 Sep 2026 18:19:49 +0100
Subject: [PATCH] Fix deadlock from recursive RLock in Order() (#555)

orderForDisplay takes a lock because many of its other callers don't
take a lock themselves, but it leads to a recursive lock in this case. The
only reason that Order() takes a lock at all is in case of simultaneous
update of its Status, so releasing the lock after reading the order and
before rendering it is fine.
---
 wfe/wfe.go | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/wfe/wfe.go b/wfe/wfe.go
index 3e4973f..f4ebbe8 100644
--- a/wfe/wfe.go
+++ b/wfe/wfe.go
@@ -2066,9 +2066,13 @@ func (wfe *WebFrontEndImpl) Order(
 		response.WriteHeader(http.StatusNotFound)
 		return
 	}
+	// Read what is needed here and release the lock again: holding it
+	// across orderForDisplay(), which takes it a second time, deadlocks
+	// if a writer queues up in between.
 	order.RLock()
 	orderAccountID := order.AccountID
-	defer order.RUnlock()
+	orderStatus := order.Status
+	order.RUnlock()
 
 	// If the request was authenticated we need to make sure that the
 	// authenticated account owns the order being requested
@@ -2080,7 +2084,7 @@ func (wfe *WebFrontEndImpl) Order(
 		}
 	}
 
-	if order.Status == acme.StatusProcessing {
+	if orderStatus == acme.StatusProcessing {
 		addRetryAfterHeader(response, wfe.retryAfterOrder)
 	}
 
